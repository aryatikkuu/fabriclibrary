{
  "name": "digital-textile-library",
  "version": "1.0.0",
  "private": true,
  "description": "Premium digital textile archive \u2014 automated fabric ingestion, AI extraction, and searchable fabric library.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/seed.mjs",
    "extract": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/batch-extract.mjs",
    "bulk-insert": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/bulk-insert.mjs",
    "verify-tag": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/verify-and-tag.mjs",
    "retag": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/retag-looks.mjs",
    "embed": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/embed-descriptions.mjs",
    "dedupe": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/dedupe-fabrics.mjs",
    "backup": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/backup.mjs",
    "restore": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/restore.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
